# --- Required ---
# Discord Developer Portal -> your app -> Bot -> Reset Token
DISCORD_BOT_TOKEN=
# Discord Developer Portal -> your app -> General Information -> Application ID
DISCORD_APP_ID=
# GitHub -> Settings -> Developer settings -> GitHub Apps -> your app -> Client ID
GITHUB_CLIENT_ID=
# Same page -> Generate a new client secret
GITHUB_CLIENT_SECRET=
# 32 random bytes, hex. Signs the OAuth state. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
STATE_SECRET=
# Public HTTPS origin of this bot, no trailing slash. The GitHub App callback URL must be PUBLIC_URL + /auth/callback
PUBLIC_URL=https://crackedbot.fly.dev

# --- Optional ---
# HTTP port (default 8080)
PORT=8080
# Where the SQLite file lives (default ./data). On Fly this is /data (the mounted volume)
DATA_DIR=./data
# Classic personal access token with NO scopes. Used for badge refreshes and /rescore. Raises public read limit 60 -> 5000/hr
GITHUB_APP_FALLBACK_TOKEN=
# info | debug | warn
LOG_LEVEL=info
# 1 = give the "unverified" lifecycle role to members the moment they join (see /rubric roles).
# Needs the privileged "Server Members Intent" switched on in the Discord Developer Portal (Bot tab),
# or login fails with "Used disallowed intents". Everything else works with this at 0.
ENABLE_MEMBER_INTENT=0
# Public repo URL shown in badges and the callback page
REPO_URL=https://github.com/yourname/crackedbot
